# ==============================================================================
# MathQuest V3 - Configuración de Pago Manual Yape y WhatsApp para VIP
# ==============================================================================

# Número de celular para recibir pagos manuales por Yape (ejemplo: 987654321)
# Configura aquí el número al que los usuarios enviarán su pago de S/ 4.90
VITE_YAPE_NUMBER=987654321

# Número de WhatsApp para recibir las capturas de comprobantes de pago
# Formato internacional numérico sin espacios ni símbolos '+' (ejemplo para Perú: 51987654321)
VITE_WHATSAPP_NUMBER=51987654321

# Precio de MathQuest VIP en Soles (PEN)
VITE_VIP_PRICE=4.90
