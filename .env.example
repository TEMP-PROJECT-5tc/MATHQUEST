# Configuración de Pasarela de Pagos Culqi / Yape para MathQuest VIP
# IMPORTANTE: Nunca expongas la clave secreta (CULQI_SECRET_KEY) en el cliente o repositorio público.
# Obtén tus claves en tu panel de Culqi (https://panel.culqi.com/)

# Clave pública de Culqi (pk_test_... en pruebas o pk_live_... en producción)
CULQI_PUBLIC_KEY=

# Clave privada secreta de Culqi (sk_test_... en pruebas o sk_live_... en producción)
CULQI_SECRET_KEY=

# Clave o secreto de webhook para validar eventos entrantes de Culqi
CULQI_WEBHOOK_SECRET=

# Modo de pruebas / Sandbox (true para pruebas sin dinero real, false para producción)
CULQI_SANDBOX=true

# Precio de MathQuest VIP en céntimos de Soles (PEN) -> 1990 céntimos = S/ 19.90 PEN
VIP_PRICE_CENTS=1990
VIP_CURRENCY=PEN
